build/
tests/build_tests/
# Ignore external deps except snarls vendored files.
external/*
!external/snarls/
external/snarls/*
!external/snarls/CMakeLists.txt
!external/snarls/README.md
!external/snarls/vendored/
!external/snarls/libhandlegraph/
!external/snarls/structures/
external/snarls/vendored/*.o

# CMake build artifacts
CMakeCache.txt
CMakeFiles/
Makefile
cmake_install.cmake
install_manifest.txt
*.so
*.a

# Install directory
dinara-install/
 
# IDEs
.idea/
.vscode/

# Python bytecode
__pycache__/
*.pyc

# Run directory
DinaraRun/
